<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wuling.App.ViewModels"
        xmlns:app="using:Wuling.App.Views"
        xmlns:builtin="using:Wuling.Plugins.BuiltIn"
        xmlns:pa="using:Wuling.Plugins.Abstractions"
        xmlns:py="using:Wuling.Plugins.Python"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Wuling.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="武陵选片局" Width="1440" Height="900" MinWidth="1120" MinHeight="720">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开目录…" Command="{Binding OpenDirectoryCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="保存进度" Command="{Binding SaveSessionCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="完成并处理…" Command="{Binding CommitCommand}" InputGesture="Ctrl+Enter" />
                <MenuItem Header="处理设置…" Click="OnOpenSettings" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding $parent[Window].Close}" />
            </MenuItem>
        </Menu>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Greeting}" VerticalAlignment="Center" Opacity="0.7" />
                    <Button Content="完成" Command="{Binding CommitCommand}" FontWeight="SemiBold" />
                    <Button Content="打开目录…" Command="{Binding OpenDirectoryCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体: 浏览条(Auto, 只占卡片高度) + 模式条(独立行) + 对比区(剩余全部) -->
        <Grid RowDefinitions="Auto,Auto,*" Margin="8,4">
            <!-- 浏览条: 高度由卡片决定, 不随选中数变化; 多选驱动对比区槽位(最多 9) -->
            <ListBox x:Name="StripList" ItemsSource="{Binding Cards}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnStripSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PhotoCardViewModel">
                        <Border Width="120" Padding="6" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Border Height="96" CornerRadius="4" Background="#1E1E1E">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   IsVisible="{Binding IsThumbnailReady}" />
                                            <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.35" IsVisible="{Binding !IsThumbnailReady}" />
                                            <TextBlock Text="RAW⇄JPG" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Margin="0,0,2,2" Opacity="0.8" Foreground="#CCFFFFFF" IsVisible="{Binding HasRawJpegPair}" />
                                        </Panel>
                                    </Border>
                                    <!-- 标记状态徽点: 右上角, 绿=选中 红=废弃(色彩+形状双通道) -->
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-4,-4,0" Stroke="#66FFFFFF" StrokeThickness="1"
                                             Fill="{Binding Tag, Converter={x:Static app:BadgeBrushConverter.Instance}}"
                                             IsVisible="{Binding IsMarked}" ToolTip.Tip="{Binding Tag}" />
                                </Grid>
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 模式条: 插件驱动(04 §5 ModeBar = PluginHost.Modes 投影) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,4,0,4">
                <TextBlock Text="对比模式" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ItemsControl ItemsSource="{Binding Modes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeButtonViewModel">
                            <ToggleButton Content="{Binding Title}"
                                          IsChecked="{Binding IsChecked, Mode=OneWay}"
                                          Command="{Binding $parent[Window].DataContext.SetModeCommand}"
                                          CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 对比区: 插件视图容器 + 宿主 chrome 层(标记按钮浮在每个槽右下, 不随模式变化; M3 插件契约中 chrome 归宿主) -->
            <Grid Grid.Row="2">
                <!-- 插件内容层: ModeView 由 PluginHost.CreateView 按当前模式产出 -->
                <ContentControl Content="{Binding ModeView}" IsVisible="{Binding !HasNoSlots}" Focusable="False">
                    <ContentControl.DataTemplates>
                        <!-- builtin.jpeg: 图片网格(每格图片 + 文件名/EXIF 摘要浮条) -->
                        <DataTemplate x:DataType="builtin:JpegPreviewViewModel">
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding $parent[Window].DataContext.Columns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="builtin:SlotViewModel">
                                        <Border Margin="2" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                            <Panel>
                                                <Border CornerRadius="8" Background="#1E1E1E">
                                                    <TextBlock Text="🖼" FontSize="40" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Opacity="0.3"
                                                               IsVisible="{Binding Bitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                </Border>
                                                <Image Source="{Binding Bitmap}" Stretch="Uniform" />
                                                <TextBlock Text="RAW⇄JPG" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                           Margin="0,6,6,0" Opacity="0.8" Foreground="#CCFFFFFF" IsVisible="{Binding HasRawJpegPair}" />
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                        Margin="0,0,0,10" CornerRadius="4" Padding="10,2"
                                                        Background="#99000000">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>

                        <!-- builtin.exif: 每槽一张参数卡(卡头文件名 + 字段行), 差异字段高亮 -->
                        <DataTemplate x:DataType="builtin:ExifCompareViewModel">
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding $parent[Window].DataContext.Columns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="builtin:ExifSlotCard">
                                        <Border Margin="2" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="#44FFFFFF"
                                                Background="#F2222222">
                                            <ScrollViewer>
                                                <StackPanel Margin="12,8">
                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#FFFFFFFF" Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="builtin:ExifFieldRow">
                                                                <Grid ColumnDefinitions="72,*" Margin="0,3">
                                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                                               Foreground="#99FFFFFF" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding OwnValue}" FontSize="12" TextWrapping="Wrap"
                                                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                                                               Foreground="{Binding Differs, Converter={x:Static app:DiffersToBrushConverter.Instance}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                        <!-- builtin.hello: 每槽文件名 + 来源(双语言契约等价验收) -->
                        <DataTemplate x:DataType="builtin:HelloViewModel">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding $parent[Window].DataContext.Columns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="builtin:HelloRow">
                                        <Border Margin="2" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                Background="#F2222222">
                                            <StackPanel Margin="12,8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Index, StringFormat='槽 {0}'}" FontSize="11" Foreground="#99FFFFFF" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#FFFFFFFF" Margin="0,4,0,8" />
                                                <TextBlock Text="{Binding Source}" FontSize="12" Foreground="#CCFFFFFF" />
                                                <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="#99FFFFFF" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>

                        <!-- Python 插件: 声明式视图树渲染(image 引用路径;stack/row/kv/text) -->
                        <DataTemplate x:DataType="py:PythonViewEnvelope">
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding $parent[Window].DataContext.Columns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="py:PythonSlotView">
                                        <Border Margin="2" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                            <Panel>
                                                <!-- 解码失败/无图占位 -->
                                                <Border CornerRadius="8" Background="#1E1E1E">
                                                    <TextBlock Text="🐍" FontSize="40" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Opacity="0.3"
                                                               IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                </Border>
                                                <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" />
                                                <!-- 文字浮条: 深底白字, 浅色主题下也可读 -->
                                                <Border VerticalAlignment="Bottom" Margin="8" CornerRadius="4" Padding="10,6"
                                                        Background="#99000000">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                                        <ItemsControl ItemsSource="{Binding KvPairs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="py:PythonKvPair">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding Key}" FontSize="11" Foreground="#99FFFFFF" />
                                                                        <TextBlock Text="{Binding Value}" FontSize="11" Foreground="#E6FFFFFF" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

                <!-- 宿主 chrome 层: 标记按钮浮在每个槽右下角, 覆盖所有模式(M3 插件契约中 chrome 归宿主);
                     用与内容层相同的 UniformGrid 保证对齐; 激活态由 MarkToBrushConverter 按 Tag 声明式驱动 -->
                <ItemsControl ItemsSource="{Binding Slots}" Focusable="False" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding $parent[Window].DataContext.Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoCardViewModel">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Spacing="4" Margin="0,0,8,8">
                                <Button Click="OnToggleSelected" ToolTip.Tip="标记选中 / 取消"
                                        Background="{Binding Tag, Converter={x:Static app:MarkToBrushConverter.SelectedInstance}}">
                                    <TextBlock Text="✅" />
                                </Button>
                                <Button Click="OnToggleRejected" ToolTip.Tip="标记废弃 / 取消"
                                        Background="{Binding Tag, Converter={x:Static app:MarkToBrushConverter.RejectedInstance}}">
                                    <TextBlock Text="🗑" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态: 无多选时 -->
                <TextBlock Text="对比区 — 在上方浏览条多选(最多 9 张)即进入对比区"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.5" IsVisible="{Binding HasNoSlots}" />
            </Grid>
        </Grid>
    </DockPanel>

</Window>
